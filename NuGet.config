<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Cleared first, so a restore does not silently pick up whatever feeds happen to be configured
    on the machine or the build agent. Every package the project needs comes from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <config>
    <!-- Where packages.config restore puts the packages the csproj HintPaths point at -->
    <add key="repositoryPath" value="packages" />
  </config>
</configuration>
